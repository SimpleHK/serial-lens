#!/bin/sh
# Fast guardrails only: typecheck + manifest + unit tests (seconds).
# Integration tests need the virtual COM pair and run separately
# (`npm run test:integration`) — do not add them here.
set -e
cd "$(git rev-parse --show-toplevel)"
npm run typecheck
npm run check:manifest
npm test
# `npm test` auto-syncs the README test count when the suite grew. The sync
# lands in the working tree: stage it and retry the commit — staging it here
# would also sweep up any README edits the author chose not to stage.
if ! git diff --quiet -- README.md; then
  echo "pre-commit: README test count was stale and has been auto-synced."
  echo "pre-commit: run 'git add README.md' and commit again."
  exit 1
fi
