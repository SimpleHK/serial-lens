{
  "name": "vscode-serial-monitor-oss",
  "displayName": "Serial Monitor (OSS)",
  "description": "Monitor serial ports in VS Code, with tag highlighting, filtering, and scroll lock.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "simplehk",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimpleHK/vscode-serial-monitor-oss"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "serialMonitor.open",
        "title": "Open Monitor",
        "category": "Serial Monitor"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "serialMonitor",
          "title": "Serial Monitor",
          "icon": "assets/serial-monitor.svg"
        }
      ]
    },
    "views": {
      "serialMonitor": [
        {
          "type": "webview",
          "id": "serialMonitor.view",
          "name": "Serial Monitor"
        }
      ]
    },
    "configuration": {
      "title": "Serial Monitor",
      "properties": {
        "serialMonitor.tags": {
          "type": "array",
          "default": [],
          "markdownDescription": "Tags: named row-matching rules (pattern + color + enabled state) consumed by highlighting and filtering. Usually managed from the monitor UI.",
          "items": {
            "type": "object",
            "required": ["name", "pattern", "isRegex", "color", "enabled"],
            "properties": {
              "name": { "type": "string", "description": "Display name; the stable key used by chips." },
              "pattern": { "type": "string", "description": "Literal substring, or regex source when isRegex is true." },
              "isRegex": { "type": "boolean", "description": "Whether pattern is a regular expression instead of a substring." },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Hex color used for the full-line highlight and the chip." },
              "enabled": { "type": "boolean", "description": "Disabled tags drive neither highlighting nor filtering." }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/build-integration.mjs && node dist/integration/runTest.js",
    "smoke:check": "node scripts/vserial-check.mjs",
    "smoke:device": "node scripts/virtual-device.mjs"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24.0",
    "mocha": "^11.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
