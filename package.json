{
  "name": "vscode-serial-monitor-oss",
  "displayName": "Serial Monitor (OSS)",
  "description": "Monitor serial ports in VS Code, with tag highlighting, filtering, and scroll lock.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "simplehk",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimpleHK/vscode-serial-monitor-oss"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "serialMonitor.open",
        "title": "Open Monitor",
        "category": "Serial Monitor"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "serialMonitor",
          "title": "Serial Monitor",
          "icon": "assets/serial-monitor.svg"
        }
      ]
    },
    "views": {
      "serialMonitor": [
        {
          "type": "webview",
          "id": "serialMonitor.view",
          "name": "Serial Monitor"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/build-integration.mjs && node dist/integration/runTest.js",
    "smoke:check": "node scripts/vserial-check.mjs",
    "smoke:device": "node scripts/virtual-device.mjs"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24.0",
    "mocha": "^11.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
