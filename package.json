{
  "name": "vscode-serial-monitor-oss",
  "displayName": "Serial Monitor (OSS)",
  "description": "Monitor serial ports in VS Code, with tag highlighting, filtering, and scroll lock.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "simplehk",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimpleHK/vscode-serial-monitor-oss"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "serialMonitor.open",
        "title": "Open Monitor",
        "category": "Serial Monitor"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
